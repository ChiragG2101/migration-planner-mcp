{
  "name": "migration-planner-mcp",
  "version": "0.0.0",
  "description": "Local-first migration engine with migration packs: plans and verifies framework upgrades without writing to your repo.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "migration-planner-mcp": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/store/migrations",
    "src/lang/python/grammar",
    "knowledge",
    "packs",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:permissions": "vitest run test/permissions",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsx scripts/lint-packs.ts",
    "recall": "tsx eval/seeded/recall.ts",
    "eval": "tsx eval/runner.ts",
    "eval:smoke": "tsx eval/runner.ts --smoke",
    "eval:add-only": "tsx scripts/check-eval-add-only.ts",
    "check:core-untouched": "tsx scripts/check-core-untouched.ts",
    "eval:pack-gate": "tsx eval/runner.ts --pack-gate",
    "truth:derive": "tsx scripts/derive-truth.ts",
    "cases:find": "tsx scripts/find-golden-cases.ts",
    "cases:verify": "tsx scripts/verify-case.ts",
    "cases:fetch": "tsx eval/caseCommits.ts",
    "runs:export": "tsx scripts/export-run.ts",
    "feedback:case": "tsx scripts/feedback-to-case.ts",
    "build:packs": "tsx scripts/build-pack.ts",
    "knowledge:draft": "tsx scripts/draft-release.ts",
    "pack:report": "tsx scripts/pack-docs-report.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
