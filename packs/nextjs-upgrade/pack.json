    { "kind": "renamed_api", "lens": "api" },
    { "kind": "removed_api", "lens": "api" },
    { "kind": "runtime_config", "lens": "api" },
    { "kind": "removed_package", "lens": "api" },
    { "kind": "deprecated_import", "lens": "api" },
    { "kind": "internal_import", "lens": "api" },
    { "kind": "request_geo", "lens": "api" },
    { "kind": "middleware", "lens": "api" },
    { "kind": "react_removed_api", "lens": "api" },
    { "kind": "react_renamed_api", "lens": "api" },
