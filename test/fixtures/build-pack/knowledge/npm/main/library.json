{
  "id": "npm/main",
  "ecosystem": "npm",
  "packages": ["main"],
  "language": "ts",
  "version_scheme": "semver",
  "release_unit": "major",
  "covered_from": "14",
  "doc_sources": ["https://example.org/docs/"],
  "release_notes": {
    "fetch": "https://example.org/{version}.md",
    "page": "https://example.org/docs/{version}",
    "format": "md",
    "sections": [{ "heading": "*" }],
    "skip": []
  },
  "codemods": [{ "id": "next-codemod:upgrade", "notes": "the upgrade" }]
}
